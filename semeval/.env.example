# Environment
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
POSTGRES_DB=semeval
POSTGRES_USER=semeval
POSTGRES_PASSWORD=semeval_dev_secret

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO in dev, real S3 in prod)
MINIO_ROOT_USER=semeval_minio
MINIO_ROOT_PASSWORD=semeval_minio_secret
MINIO_BUCKET=semeval-audio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=semeval_minio
STORAGE_SECRET_KEY=semeval_minio_secret
STORAGE_BUCKET=semeval-audio
STORAGE_REGION=us-east-1

# ── Auth ─────────────────────────────────────────────────────────────────────
# Set to "false" in production. "true" here for Phase 0-4 dev.
DISABLE_AUTH=true
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4o
LLM_PRIMARY_MODEL_VERSION=2024-11-20
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=sk-...replace-me...
ANTHROPIC_API_KEY=sk-ant-...replace-me...

# ── ASR ──────────────────────────────────────────────────────────────────────
# "faster_whisper" (local, no key) or "deepgram" / "assemblyai" (cloud)
ASR_ADAPTER=faster_whisper
FASTER_WHISPER_MODEL=large-v3
FASTER_WHISPER_DEVICE=cpu
DEEPGRAM_API_KEY=...replace-me-if-using-deepgram...

# ── Scoring reproducibility ───────────────────────────────────────────────────
LLM_TEMPERATURE=0
LLM_SEED=42

# ── Retention ─────────────────────────────────────────────────────────────────
AUDIO_RETENTION_DAYS=90
TRANSCRIPT_RETENTION_DAYS=730

# ── Concurrency ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS_PER_TENANT=3
QUEUE_VISIBILITY_TIMEOUT_S=300

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_DIARIZATION=true
ENABLE_IDENTITY_CHECK=true
ENABLE_PROMPT_INJECTION_DETECTION=true
