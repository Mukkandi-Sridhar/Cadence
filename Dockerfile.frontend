# ── Build stage ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy source
COPY . .

# Build shared-types first
RUN if [ -d "semeval/packages/shared-types" ]; then \
      cd semeval/packages/shared-types && npm install && npm run build; \
    elif [ -d "packages/shared-types" ]; then \
      cd packages/shared-types && npm install && npm run build; \
    elif [ -d "../packages/shared-types" ]; then \
      cd ../packages/shared-types && npm install && npm run build; \
    fi

# Build frontend
RUN if [ -d "semeval/frontend" ]; then \
      cd semeval/frontend && npm install && npm run build && cp -r dist /app/dist; \
    elif [ -f "package.json" ]; then \
      npm install && npm run build && cp -r dist /app/dist; \
    fi

# ── Serve stage ─────────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# SPA routing config
RUN echo $'server {\n\
    listen 80;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
